        {
            "name": "06 - JWT Authorization",
            "item": [
                {
                    "name": "Protected Endpoint Template",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/protected-test",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "protected-test"
                            ]
                        },
                        "description": "Replace this endpoint with an actual protected EventHub endpoint. For example, an event endpoint protected with @PreAuthorize(\"hasAuthority('MANAGE_EVENTS')\")."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Protected endpoint responds', function () {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 403, 404]);",
                                    "});"
                                ]
                            }
                        }
                    ]
