{
    "info": {
        "_postman_id": "d7d26d3a-6f45-4b3d-9a3a-6d0cdb1c8c21",
        "name": "EventHub - Auth API",
        "description": "Postman collection for testing EventHub JWT authentication, refresh-token rotation, logout, and authenticated user access.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8080",
            "type": "string"
        },
        {
            "key": "accessToken",
            "value": "",
            "type": "string"
        },
        {
            "key": "registeredEmail",
            "value": "romille.auth.test@example.com",
            "type": "string"
        },
        {
            "key": "registeredPassword",
            "value": "Password123!",
            "type": "string"
        },
        {
            "key": "registeredFirstName",
            "value": "Romille",
            "type": "string"
        },
        {
            "key": "registeredLastName",
            "value": "Test",
            "type": "string"
        },
        {
            "key": "companyName",
            "value": "EventHub Test Organization",
            "type": "string"
        },
        {
            "key": "primaryContactEmail",
            "value": "romille.contact@example.com",
            "type": "string"
        },
        {
            "key": "primaryContactPhone",
            "value": "+639171234567",
            "type": "string"
        }
    ],
    "auth": {
        "type": "noauth"
    },
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
                ]
            }
        }
    ],
    "item": [
        {
            "name": "01 - Register",
            "item": [
                {
                    "name": "Register Organizer",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{registeredEmail}}\",\n  \"password\": \"{{registeredPassword}}\",\n  \"firstName\": \"{{registeredFirstName}}\",\n  \"lastName\": \"{{registeredLastName}}\",\n  \"companyName\": \"{{companyName}}\",\n  \"primaryContactEmail\": \"{{primaryContactEmail}}\",\n  \"primaryContactPhone\": \"{{primaryContactPhone}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "register"
                            ]
                        },
                        "description": "Creates an organization and its first ORGANIZER_ADMIN user."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Registration returns 201 Created', function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Register - Duplicate Email",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{registeredEmail}}\",\n  \"password\": \"{{registeredPassword}}\",\n  \"firstName\": \"Duplicate\",\n  \"lastName\": \"User\",\n  \"companyName\": \"Duplicate Organization\",\n  \"primaryContactEmail\": \"duplicate.contact@example.com\",\n  \"primaryContactPhone\": \"+639171111111\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "register"
                            ]
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Duplicate email is rejected', function () {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([400, 409]);",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Register - Invalid Payload",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"123\",\n  \"firstName\": \"\",\n  \"lastName\": \"\",\n  \"companyName\": \"\",\n  \"primaryContactEmail\": \"invalid\",\n  \"primaryContactPhone\": \"+639171234567\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "register"
                            ]
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Invalid registration payload returns 400', function () {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
                                    "});"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "02 - Login",
            "item": [
                {
                    "name": "Login - Valid Credentials",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{registeredEmail}}\",\n  \"password\": \"{{registeredPassword}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "login"
                            ]
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Login succeeds', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "const json = pm.response.json();",
                                    "",
                                    "pm.test('Access token exists', function () {",
                                    "    pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
                                    "});",
                                    "",
                                    "pm.test('Token type is Bearer', function () {",
                                    "    pm.expect(json.tokenType).to.eql('Bearer');",
                                    "});",
                                    "",
                                    "pm.test('expiresIn exists', function () {",
                                    "    pm.expect(json.expiresIn).to.be.a('number');",
                                    "});",
                                    "",
                                    "pm.test('User information exists', function () {",
                                    "    pm.expect(json.user).to.exist;",
                                    "});",
                                    "",
                                    "pm.test('Password hash is not returned', function () {",
                                    "    pm.expect(json).to.not.have.property('passwordHash');",
                                    "    pm.expect(json.user).to.not.have.property('passwordHash');",
                                    "});",
                                    "",
                                    "pm.environment.set('accessToken', json.accessToken);"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Login - Invalid Password",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{registeredEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/login",
                            "host": [
                                "{{baseUrl}}"
