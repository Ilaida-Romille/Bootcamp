                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Invalid login payload returns 400', function () {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
                                    "});"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "03 - Authenticated User",
            "item": [
                {
                    "name": "Get Current User",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/me",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "me"
                            ]
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Authenticated request succeeds', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "const json = pm.response.json();",
                                    "",
                                    "pm.test('User contains expected fields', function () {",
                                    "    pm.expect(json).to.have.property('id');",
                                    "    pm.expect(json).to.have.property('email');",
                                    "    pm.expect(json).to.have.property('role');",
                                    "    pm.expect(json).to.have.property('status');",
                                    "});",
                                    "",
                                    "pm.test('Password hash is never exposed', function () {",
                                    "    pm.expect(json).to.not.have.property('passwordHash');",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Get Current User - No Token",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/me",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "me"
                            ]
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Unauthenticated request is rejected', function () {",
                                    "    pm.response.to.have.status(401);",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Get Current User - Invalid Token",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer invalid.jwt.token"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/me",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "me"
                            ]
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Invalid JWT is rejected', function () {",
                                    "    pm.response.to.have.status(401);",
                                    "});"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "04 - Refresh Token",
            "item": [
                {
                    "name": "Refresh Access Token",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "cookie": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/refresh",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "refresh"
                            ]
                        },
                        "description": "Postman should automatically send the eventhub_refresh HttpOnly cookie previously set by login."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Refresh succeeds', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "const json = pm.response.json();",
                                    "",
                                    "pm.test('A new access token is returned', function () {",
                                    "    pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
                                    "});",
                                    "",
                                    "pm.test('Token type is Bearer', function () {",
                                    "    pm.expect(json.tokenType).to.eql('Bearer');",
                                    "});",
                                    "",
                                    "pm.environment.set('accessToken', json.accessToken);"
                                ]
                            }
                        }
                    ]
                },
