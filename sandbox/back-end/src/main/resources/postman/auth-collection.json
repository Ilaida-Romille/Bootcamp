                                "refresh"
                            ]
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Missing refresh token is rejected', function () {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([401, 400]);",
                                    "});"
                                ]
