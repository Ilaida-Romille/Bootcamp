    EVENTS ||--o{ EVENT_REGISTRATIONS : "receives_registrations"
    EVENTS ||--o{ NOTIFICATION_LOGS : "triggers"
    EVENTS ||--o{ INVOICE_ITEMS : "itemized_in"

